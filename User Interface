<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Arduino Sensor Station Dashboard</title>
  <!-- Tailwind CSS for UI styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js for real-time graphs -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen pb-12">

  <!-- Top Header Navigation -->
  <header class="border-b border-slate-800 bg-slate-950/50 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-wrap justify-between items-center gap-4">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-indigo-600 rounded-lg text-white">
          <i data-lucide="activity" class="w-6 h-6"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg leading-none">Sensor Station Monitor</h1>
          <p class="text-xs text-slate-400 mt-1">Live Multi-Sensor CSV Feed</p>
        </div>
      </div>

      <!-- Action Controls -->
      <div class="flex items-center gap-3">
        <span id="status-badge" class="px-3 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-red-500"></span> Disconnected
        </span>
        
        <button id="connect-btn" onclick="toggleConnect()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm rounded-lg transition-colors flex items-center gap-2">
          <i data-lucide="plug" class="w-4 h-4"></i> Connect Arduino
        </button>

        <button id="export-btn" onclick="exportCSV()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium text-sm rounded-lg border border-slate-700 transition-colors flex items-center gap-2">
          <i data-lucide="download" class="w-4 h-4"></i> Export CSV
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 mt-8 space-y-8">

    <!-- 1. Environmental Sensors Section -->
    <div>
      <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4 flex items-center gap-2">
        <i data-lucide="thermometer" class="w-4 h-4 text-indigo-400"></i> Environmental Station (DHT11 & HW-611 / BMP280)
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- DHT Temp -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 relative overflow-hidden">
          <p class="text-xs font-medium text-slate-400">DHT11 Temp</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span id="val-dht-temp" class="text-3xl font-bold tracking-tight text-white">--</span>
            <span class="text-sm text-slate-400">°C</span>
          </div>
          <div class="mt-2 text-xs text-slate-500">Digital Pin 9</div>
        </div>

        <!-- DHT Humidity -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 relative overflow-hidden">
          <p class="text-xs font-medium text-slate-400">DHT11 Humidity</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span id="val-dht-hum" class="text-3xl font-bold tracking-tight text-cyan-400">--</span>
            <span class="text-sm text-slate-400">%</span>
          </div>
          <div class="mt-2 text-xs text-slate-500">Digital Pin 9</div>
        </div>

        <!-- BMP Temp -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 relative overflow-hidden">
          <p class="text-xs font-medium text-slate-400">BMP280 Temp</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span id="val-bmp-temp" class="text-3xl font-bold tracking-tight text-amber-400">--</span>
            <span class="text-sm text-slate-400">°C</span>
          </div>
          <div class="mt-2 text-xs text-slate-500">I2C (0x76) - A4/A5</div>
        </div>

        <!-- BMP Pressure -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 relative overflow-hidden">
          <p class="text-xs font-medium text-slate-400">Barometric Pressure</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span id="val-bmp-press" class="text-3xl font-bold tracking-tight text-emerald-400">--</span>
            <span class="text-sm text-slate-400">hPa</span>
          </div>
          <div class="mt-2 text-xs text-slate-500">I2C (0x76) - A4/A5</div>
        </div>

      </div>
    </div>

    <!-- 2. Gas & Light Sensors Section -->
    <div>
      <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4 flex items-center gap-2">
        <i data-lucide="wind" class="w-4 h-4 text-indigo-400"></i> Air Quality & Light (Analog Sensors)
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        
        <!-- MQ3 -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-4">
          <div class="flex justify-between items-center text-xs text-slate-400 mb-1">
            <span>MQ-3 (Alcohol)</span>
            <span class="font-mono text-[10px] text-slate-500">A2</span>
          </div>
          <div class="text-2xl font-bold text-slate-100" id="val-mq3">--</div>
          <div class="w-full bg-slate-700 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="bar-mq3" class="bg-indigo-500 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>

        <!-- MQ4 -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-4">
          <div class="flex justify-between items-center text-xs text-slate-400 mb-1">
            <span>MQ-4 (Methane)</span>
            <span class="font-mono text-[10px] text-slate-500">A7</span>
          </div>
          <div class="text-2xl font-bold text-slate-100" id="val-mq4">--</div>
          <div class="w-full bg-slate-700 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="bar-mq4" class="bg-indigo-500 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>

        <!-- MQ7 -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-4">
          <div class="flex justify-between items-center text-xs text-slate-400 mb-1">
            <span>MQ-7 (Carbon Monoxide)</span>
            <span class="font-mono text-[10px] text-slate-500">A6</span>
          </div>
          <div class="text-2xl font-bold text-slate-100" id="val-mq7">--</div>
          <div class="w-full bg-slate-700 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="bar-mq7" class="bg-indigo-500 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>

        <!-- Benzene -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-4">
          <div class="flex justify-between items-center text-xs text-slate-400 mb-1">
            <span>Benzene Sensor</span>
            <span class="font-mono text-[10px] text-slate-500">A3</span>
          </div>
          <div class="text-2xl font-bold text-slate-100" id="val-benzene">--</div>
          <div class="w-full bg-slate-700 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="bar-benzene" class="bg-indigo-500 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>

        <!-- LDR -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-4">
          <div class="flex justify-between items-center text-xs text-slate-400 mb-1">
            <span>LDR (Light)</span>
            <span class="font-mono text-[10px] text-slate-500">A1</span>
          </div>
          <div class="text-2xl font-bold text-amber-300" id="val-ldr">--</div>
          <div class="w-full bg-slate-700 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="bar-ldr" class="bg-amber-400 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>

      </div>
    </div>

    <!-- 3. Real-Time Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Chart 1: Temperature & Humidity -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5">
        <h3 class="text-sm font-semibold text-slate-300 mb-4">Environmental Trends</h3>
        <div class="h-64">
          <canvas id="envChart"></canvas>
        </div>
      </div>

      <!-- Chart 2: Gas Sensor Analog Raw Values -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5">
        <h3 class="text-sm font-semibold text-slate-300 mb-4">Gas Sensor Levels (0 - 1023)</h3>
        <div class="h-64">
          <canvas id="gasChart"></canvas>
        </div>
      </div>

    </div>

  </main>

  <script>
    // Initialize icons
    lucide.createIcons();

    let port, reader;
    let isConnected = false;
    let csvDataHistory = ["DHT_Temp(C),DHT_Hum(%),BMP_Temp(C),BMP_Press(hPa),MQ3_Alc,MQ4_CH4,MQ7_CO,Benzene,LDR_Light,Timestamp"];

    // Chart initialization
    const maxDataPoints = 20;

    const envCtx = document.getElementById('envChart').getContext('2d');
    const envChart = new Chart(envCtx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [
          { label: 'DHT Temp (°C)', borderColor: '#6366f1', backgroundColor: 'transparent', data: [], tension: 0.3 },
          { label: 'BMP Temp (°C)', borderColor: '#fbbf24', backgroundColor: 'transparent', data: [], tension: 0.3 },
          { label: 'Humidity (%)', borderColor: '#22d3ee', backgroundColor: 'transparent', data: [], tension: 0.3 }
        ]
      },
      options: { responsive: true, maintainAspectRatio: false, scales: { x: { grid: { color: '#334155' } }, y: { grid: { color: '#334155' } } } }
    });

    const gasCtx = document.getElementById('gasChart').getContext('2d');
    const gasChart = new Chart(gasCtx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [
          { label: 'MQ3', borderColor: '#ef4444', backgroundColor: 'transparent', data: [], tension: 0.2 },
          { label: 'MQ4', borderColor: '#10b981', backgroundColor: 'transparent', data: [], tension: 0.2 },
          { label: 'MQ7', borderColor: '#f59e0b', backgroundColor: 'transparent', data: [], tension: 0.2 },
          { label: 'Benzene', borderColor: '#a855f7', backgroundColor: 'transparent', data: [], tension: 0.2 }
        ]
      },
      options: { responsive: true, maintainAspectRatio: false, scales: { x: { grid: { color: '#334155' } }, y: { grid: { color: '#334155' }, min: 0, max: 1023 } } }
    });

    // Web Serial Toggle Function
    async function toggleConnect() {
      if (!('serial' in navigator)) {
        alert("Web Serial API is not supported in this browser. Please use Chrome, Edge, or Opera.");
        return;
      }

      if (isConnected) {
        if (reader) await reader.cancel();
        if (port) await port.close();
        updateStatus(false);
      } else {
        try {
          port = await navigator.serial.requestPort();
          await port.open({ baudRate: 9600 });
          updateStatus(true);
          readSerialData();
        } catch (err) {
          console.error("Serial connection error: ", err);
        }
      }
    }

    function updateStatus(connected) {
      isConnected = connected;
      const badge = document.getElementById('status-badge');
      const btn = document.getElementById('connect-btn');

      if (connected) {
        badge.className = "px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5";
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Live Stream`;
        btn.innerHTML = `<i data-lucide="power" class="w-4 h-4"></i> Disconnect`;
        btn.classList.replace('bg-indigo-600', 'bg-red-600');
        btn.classList.replace('hover:bg-indigo-500', 'hover:bg-red-500');
      } else {
        badge.className = "px-3 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20 flex items-center gap-1.5";
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-red-500"></span> Disconnected`;
        btn.innerHTML = `<i data-lucide="plug" class="w-4 h-4"></i> Connect Arduino`;
        btn.classList.replace('bg-red-600', 'bg-indigo-600');
        btn.classList.replace('hover:bg-red-500', 'hover:bg-indigo-500');
      }
      lucide.createIcons();
    }

    // Stream Reader
    async function readSerialData() {
      const textDecoder = new TextDecoderStream();
      const readableStreamClosed = port.readable.pipeTo(textDecoder.writable);
      reader = textDecoder.readable.getReader();

      let buffer = "";

      while (true) {
        const { value, done } = await reader.read();
        if (done) {
          reader.releaseLock();
          break;
        }
        buffer += value;
        let lines = buffer.split("\n");
        buffer = lines.pop(); // Hold incomplete trailing fragment

        for (let line of lines) {
          line = line.trim();
          if (line && !line.startsWith("DHT_Temp")) { // Ignore CSV Header line
            parseCSVLine(line);
          }
        }
      }
    }

    // Parse CSV: [DHT_Temp, DHT_Hum, BMP_Temp, BMP_Press, MQ3, MQ4, MQ7, Benzene, LDR]
    function parseCSVLine(line) {
      const parts = line.split(',');
      if (parts.length < 9) return;

      const dhtTemp = parseFloat(parts[0]);
      const dhtHum = parseFloat(parts[1]);
      const bmpTemp = parseFloat(parts[2]);
      const bmpPress = parseFloat(parts[3]);
      const mq3 = parseInt(parts[4]);
      const mq4 = parseInt(parts[5]);
      const mq7 = parseInt(parts[6]);
      const benzene = parseInt(parts[7]);
      const ldr = parseInt(parts[8]);

      // Update UI Cards
      document.getElementById('val-dht-temp').textContent = isNaN(dhtTemp) ? '--' : dhtTemp.toFixed(1);
      document.getElementById('val-dht-hum').textContent = isNaN(dhtHum) ? '--' : dhtHum.toFixed(1);
      document.getElementById('val-bmp-temp').textContent = isNaN(bmpTemp) ? '--' : bmpTemp.toFixed(1);
      document.getElementById('val-bmp-press').textContent = isNaN(bmpPress) ? '--' : bmpPress.toFixed(1);

      document.getElementById('val-mq3').textContent = mq3;
      document.getElementById('val-mq4').textContent = mq4;
      document.getElementById('val-mq7').textContent = mq7;
      document.getElementById('val-benzene').textContent = benzene;
      document.getElementById('val-ldr').textContent = ldr;

      // Update progress bar widths (Analog range 0 - 1023 mapped to 0 - 100%)
      document.getElementById('bar-mq3').style.width = `${(mq3 / 1023) * 100}%`;
      document.getElementById('bar-mq4').style.width = `${(mq4 / 1023) * 100}%`;
      document.getElementById('bar-mq7').style.width = `${(mq7 / 1023) * 100}%`;
      document.getElementById('bar-benzene').style.width = `${(benzene / 1023) * 100}%`;
      document.getElementById('bar-ldr').style.width = `${(ldr / 1023) * 100}%`;

      // Save to CSV download history
      const timeStr = new Date().toLocaleTimeString();
      csvDataHistory.push(`${line},${timeStr}`);

      // Push to Charts
      pushChartData(envChart, timeStr, [dhtTemp, bmpTemp, dhtHum]);
      pushChartData(gasChart, timeStr, [mq3, mq4, mq7, benzene]);
    }

    function pushChartData(chart, label, dataArray) {
      chart.data.labels.push(label);
      dataArray.forEach((val, idx) => chart.data.datasets[idx].data.push(val));

      if (chart.data.labels.length > maxDataPoints) {
        chart.data.labels.shift();
        chart.data.datasets.forEach(ds => ds.data.shift());
      }
      chart.update();
    }

    // Export CSV file directly from browser
    function exportCSV() {
      const csvContent = "data:text/csv;charset=utf-8," + csvDataHistory.join("\n");
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `sensor_log_${new Date().toISOString().slice(0,10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  </script>
</body>
</html>
